APP_PORT=8088
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=fox_inventory
POSTGRES_USER=fox_inventory
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
FIELD_ENCRYPTION_KEY=change-me
TIME_ZONE=Europe/Moscow
MAX_UPLOAD_MB=25

# Authentication protection and login audit
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOG_DISPLAY_LIMIT=100
LOGIN_BLOCKED_LOG_INTERVAL_SECONDS=60
# Defaults to TRUST_X_FORWARDED_PROTO when omitted. Enable behind a trusted reverse proxy.
LOGIN_TRUST_PROXY_HEADERS=0
LOGIN_PROXY_IP_HEADERS=HTTP_CF_CONNECTING_IP,HTTP_X_FORWARDED_FOR,HTTP_X_REAL_IP

# Optional defaults for generated transfer documents
ACT_DEFAULT_CITY=
ACT_ISSUE_REPRESENTATIVE_POSITION=
ACT_ISSUE_REPRESENTATIVE_NAME=
ACT_RETURN_REPRESENTATIVE_POSITION=
ACT_RETURN_REPRESENTATIVE_NAME=

# Optional HTTPS hardening
TRUST_X_FORWARDED_PROTO=0
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
